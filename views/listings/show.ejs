<% layout("/layouts/boilerplate")-%>
<div class="row">
<div class="col-8 offset-2">
    <h3 class="offset-3"><%=listing.title%></h3>

   <div class="card show-card listing-card mx-auto">
   <img src="<%=listing.image.url%>"
    class="card-img-top show-img"
     alt="listing_image"
     />
   <div class="card-body">
   <p class="card-text">

    <br>
    <%=listing.description%> <br><br>
<b><span>&#8377;</span> <%=listing.price ? listing.price.toLocaleString("en-IN") : "N/A"%></b> <br><br>   <%=listing.location%>, <br>
    <b><%=listing.country%></b> <br>
   </p>
   </div>
   </div>
   <br>
   
   <div class="btns">
    <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark  offset-3 edit-btn">Edit</a>
   
   
        <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
        <button class="btn btn-dark offset-5">Delete</button>
    </form>
    </div>
    <div class="col-8 offset-3" >
        <hr>
        <h4>Leave a Review</h4>
        <form class="mb-3 needs-validation" action="/listings/<%=listing.id%>/reviews" method="post" novalidate  >
            <div class="mb-3 mt-3">
                <label for="rating" class="form-label">Rating</label>
                <input type="range" min="1" max="5" id="rating" name="review[rating]" class="form-range">
            </div>
            <div class="mb-3 mt-3">
                <label for="comment" class="form-label">Comments</label>
                <textarea name="review[comment]" id="comment" cols="30" rows="10" class="form-control" required></textarea>
                <div class="invalid-feedback">Please add some comments for review.</div>
            </div>
            <button class="btn btn-outline-dark">Submit</button>
        </form>
        <hr>
        <p><b>All Reviews</b></p>
       <div class="row">
        <%for(review of listing.reviews){%>
            
        <div class="card col-5 ms-3 mb-3">
             <div class="card-body">
            <h5 class="card-title">Harjot</h5>
             <p class="card-text"><%=review.comment%></p>
             <p class="card-text"><%=review.rating%> Stars</p>
        </div>
        <form action="/listings/<%=listing._id%>/reviews/<%=review._id %>?_method=DELETE" method="POST" class="mb-3">
        <button class="btn btn-dark">Delete</button>
        </form>
           </div> 
        <%}%>
        </div>
    </div>
    <br>
    <br>
</div>
</div>
