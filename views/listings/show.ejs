<% layout("/layouts/boilerplate")-%>
<div class="row">
<div class="col-8 offset-2">
    <h3 class="offset-2">Listing Details :</h3>

   <div class="card col-6 offset-2"  style="width: 18rem;">
   <img src="<%=listing.image.url%>"
    class="card-img-top show-img"
     alt="listing_image"
     />
   <div class="card-body">
   <p class="card-text">
    <br> <%=listing.title%> <br>
    <%=listing.description%> <br>
<span>&#8377;</span> <%=listing.price ? listing.price.toLocaleString("en-IN") : "N/A"%>    <%=listing.location%> <br>
    <%=listing.country%> <br>
   </p>
   </div>
   </div>
   
   <div class="btns">
    <a href="/listing/<%=listing._id%>/edit" class="btn btn-dark  offset-3 edit-btn">Edit</a>
   
   
        <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
        <button class="btn btn-dark offset-5">Delete</button>
    </form>
    </div>
    <br>
    <br>
</div>
</div>